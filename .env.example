# Public Sanity configuration for the blog.
NEXT_PUBLIC_SANITY_PROJECT_ID=quk77na6
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only viewer token for a private Sanity dataset.
SANITY_READ_TOKEN=viewer-token-for-server-side-blog-reads

# Use this value both in Vercel and in the Sanity webhook URL.
SANITY_REVALIDATE_SECRET=replace-with-a-long-random-value
